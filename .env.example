# Zoom Meeting SDK の認証情報
# Zoom App Marketplace の General App > Basic Information から取得する。
# Features > Embed で Meeting SDK を有効化しておくこと。
#
# 旧来の SDK Key / SDK Secret は 2026-06-27 に Client ID / Client Secret へ
# 移行が強制済み。新規は Client ID / Secret を使う。
#
# 実際の値は .env に書く。.env はコミットしない。
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=

# 検証に使うミーティング(自分のアカウント内で作成したもの)
ZOOM_MEETING_NUMBER=
ZOOM_MEETING_PASSWORD=

# overlay / WebSocket サーバー
PORT=3000
